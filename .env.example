# CoDriver B 台 docker-compose 設定範本
# 用法：cp .env.example .env，再改 .env（.env 不會進 git；金鑰只能放在 .env）

# ---- codriver-llm（vLLM）----
# 模型資料夾（主機上），裡面放 Hugging Face 下載的模型，例如 ~/codriver-models/Qwen3-8B
CODRIVER_MODELS_DIR=/home/nkust/codriver-models
# 要用的模型（資料夾名稱）：Qwen3-8B，或之後試 Qwen3.6-35B-A3B-FP8
CODRIVER_LLM_MODEL=Qwen3-8B
# 對外的模型 id（App 設定頁填這個）；留空 = 跟 CODRIVER_LLM_MODEL 一樣
CODRIVER_LLM_SERVED_NAME=
# 對外的 port（手機用 adb reverse tcp:8300 tcp:8300 連過來）；不要用 8088、11434（ai-truth-lab）
CODRIVER_LLM_PORT=8300
# 佔用整台記憶體的比例（DGX Spark 是 CPU/GPU 共用的統一記憶體）：0.25 ≈ 30 GB
# 單機測試（遊戲也在同一台）用 0.25；B 台只跑 LLM 時可以調高
CODRIVER_LLM_GPU_MEM=0.25
CODRIVER_LLM_MAX_LEN=8192
# 選填：API 金鑰。有填的話，App 的 local.properties 裡 IAI_KEY 要填一樣的值；留空 = 不檢查
CODRIVER_LLM_KEY=
# 選填：其他 vllm serve 參數
CODRIVER_LLM_EXTRA_ARGS=

# ---- codriver-bridge（BeamNG OutGauge → 手機）----
# 單機（遊戲也在這台）：127.0.0.1；雙機（A 台遊戲送到 B 台）：0.0.0.0，並在 A 台把 OutGauge 位址設成 B 台 IP
CODRIVER_OUTGAUGE_LISTEN=127.0.0.1
CODRIVER_OUTGAUGE_PORT=4444
# 手機 CoDriver（adb forward tcp:8765 tcp:8765 之後是本機 8765）
CODRIVER_PHONE=http://127.0.0.1:8765
# 塞車判斷：低於 CODRIVER_JAM_KMH km/h 持續 CODRIVER_JAM_SEC 秒，而且前方 40 公尺內至少 CODRIVER_JAM_CARS 台同方向的車 → 送 jam 給手機
CODRIVER_JAM_KMH=10
CODRIVER_JAM_SEC=20
CODRIVER_JAM_CARS=2
